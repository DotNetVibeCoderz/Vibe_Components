<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Medical.Net HL7 v2 on NHapi: parse any version, build ADT^A01, ORU^R01, ORM^O01, OML^O21, SIU^S12 and MDM^T02 (2.5.1), segment-level conformance profiles, generate ACKs, map PID/PV1/OBX to the domain model and FHIR R4, and exchange messages over MLLP (TCP server and client).</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="nhapi.base" Version="3.2.3" />
    <PackageReference Include="nhapi.model.v23" Version="3.2.4" />
    <PackageReference Include="nhapi.model.v251" Version="3.2.4" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Conformance/profiles.json" LogicalName="Medical.Hl7.Conformance.profiles.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Medical.Fhir/Medical.Fhir.csproj" />
  </ItemGroup>
</Project>
