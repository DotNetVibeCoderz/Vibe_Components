<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Native (Rust) high-performance kernels for Medical.Net — DICOM VOI window/level, pixel statistics, Pan-Tompkins ECG QRS detection and volume resampling (MPR, MIP / MinIP / AvgIP slabs) — with bit-identical managed fallbacks.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- Prebuilt native binaries produced by build/build-native.ps1 (cargo build -release). -->
    <None Include="runtimes/**/native/*" Pack="true" PackagePath="runtimes/" CopyToOutputDirectory="PreserveNewest" Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
