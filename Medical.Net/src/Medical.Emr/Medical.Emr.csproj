<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Medical.Net EMR/EHR persistence on Entity Framework Core: patients, encounters, vitals, observations, problems, medications, allergies and a persistent audit trail; SQL Server, SQLite or in-memory providers; Redis / distributed cache for patient records; synthetic seeding.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(MsExtVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(MsExtVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(MsExtVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(MsExtVersion)" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(MsExtVersion)" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="$(MsExtVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Medical.Core/Medical.Core.csproj" />
  </ItemGroup>
</Project>
