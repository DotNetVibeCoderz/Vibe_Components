<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(HisLayout)">
            <NotAuthorized><RedirectToLogin /></NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound><LayoutView Layout="typeof(HisLayout)"><p class="empty">Not found · Tidak ditemukan</p></LayoutView></NotFound>
</Router>
