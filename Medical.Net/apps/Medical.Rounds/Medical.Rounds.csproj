<Project Sdk="Microsoft.NET.Sdk">
	<!-- Medical.Net ward rounds (MAUI). Windows always; Android when the Android SDK is installed (-p:IncludeAndroid=true).
	     Not part of Medical.Net.slnx because CI runners have no MAUI workloads; build with Medical.Rounds.slnx. -->
	<PropertyGroup>
		<!-- The repo-wide Directory.Build.props sets TargetFramework=net10.0; MAUI needs platform frameworks only. -->
		<TargetFramework></TargetFramework>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(IncludeAndroid)' == 'true'">$(TargetFrameworks);net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Medical.Rounds</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<IsPackable>false</IsPackable>
		<ApplicationTitle>Medical.Net Rounds</ApplicationTitle>
		<ApplicationId>com.gravicode.medicalnet.rounds</ApplicationId>
		<ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>
		<WindowsPackageType>None</WindowsPackageType>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#14233A" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#14233A" BaseSize="128,128" />
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="../Medical.Rounds.Core/Medical.Rounds.Core.csproj" />
	</ItemGroup>
</Project>
