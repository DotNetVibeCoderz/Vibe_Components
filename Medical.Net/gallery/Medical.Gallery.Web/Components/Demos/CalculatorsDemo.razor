@inherits DemoBase
@{ var v = Scenarios.Calculators(_cr, _age, _female ? Gender.Female : Gender.Male, _wt, _ht, _drug); }
<div class="controls">
    <label>@T("Creatinine", "Kreatinin") <input type="number" step="0.1" min="0.2" max="15" @bind="_cr" /> mg/dL</label>
    <label>@T("Age", "Usia") <input type="number" min="18" max="110" @bind="_age" /></label>
    <label>@T("Weight", "Berat") <input type="number" min="3" max="250" @bind="_wt" /> kg</label>
    <label>@T("Height", "Tinggi") <input type="number" min="50" max="230" @bind="_ht" /> cm</label>
    <label class="check"><input type="checkbox" @bind="_female" /> @T("Female", "Perempuan")</label>
    <label>@T("Drug", "Obat")
        <select @bind="_drug">@foreach (var d in DoseCalculator.Rules.Keys) { <option value="@d">@d</option> }</select>
    </label>
</div>
<div class="readouts">
    <div class="readout"><span class="k">eGFR · CKD-EPI 2021</span><span class="v">@v.Egfr.Egfr<small>mL/min/1.73 m²</small></span><span class="n">@v.Egfr.Stage — @v.Egfr.Label[Lang]</span></div>
    <div class="readout"><span class="k">CrCl · Cockcroft-Gault</span><span class="v">@Scenarios.Fmt(v.CrCl)<small>mL/min</small></span><span class="n">@T("used for drug dosing", "untuk penyesuaian dosis")</span></div>
    <div class="readout"><span class="k">BMI</span><span class="v">@v.BmiWho.Bmi<small>kg/m²</small></span><span class="n">WHO: @v.BmiWho.Label[Lang] · Asia-Pacific: @v.BmiAsia.Label[Lang]</span></div>
    <div class="readout"><span class="k">BSA · Mosteller</span><span class="v">@v.Bsa<small>m²</small></span><span class="n">@T("maintenance fluids", "cairan rumatan") @v.FluidsMlH mL/h</span></div>
</div>
<div class="panel dose">
    <h3>@v.Dose.Generic</h3>
    <p class="big mono">@Scenarios.Fmt(v.Dose.SingleDoseMg) mg × @v.Dose.DosesPerDay / @T("day", "hari") = @Scenarios.Fmt(v.Dose.DailyDoseMg) mg</p>
    <p>
        @if (v.Dose.Capped) { <span class="tag">@T("capped at maximum", "dibatasi dosis maksimum")</span> }
        @if (v.Dose.RenalAdjusted) { <span class="tag warn">@T("renal adjustment", "penyesuaian ginjal")</span> }
        @v.Dose.Note[Lang]
    </p>
</div>
@code {
    private double _cr = 1.4, _wt = 58, _ht = 155;
    private int _age = 67;
    private bool _female = true;
    private string _drug = "amoxicillin";
}
