@* Labelled range input that calls back on every change. *@
<div class="control">
    <label for="@_id">@Label</label>
    <div class="row">
        <input id="@_id" type="range" min="@S(Min)" max="@S(Max)" step="@S(Step)" value="@S(Value)" @oninput="Changed" />
        <output for="@_id">@Value.ToString(Format, CultureInfo.InvariantCulture)@Unit</output>
    </div>
</div>

@code {
    private readonly string _id = "s" + Guid.NewGuid().ToString("N")[..8];
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public string Format { get; set; } = "0.#";
    [Parameter] public string Unit { get; set; } = "";
    /// <summary>Raised after Value changes (recompute here).</summary>
    [Parameter] public EventCallback OnChange { get; set; }

    private static string S(double v) => v.ToString(CultureInfo.InvariantCulture);

    private async Task Changed(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v)) return;
        Value = v;
        await ValueChanged.InvokeAsync(v);
        await OnChange.InvokeAsync();
    }
}
