@inherits DemoBase

<div class="controls">
    <Slider Label="@T("Biomass kg", "Biomassa kg")" @bind-Value="_bio" Min="500" Max="6000" Step="100" Format="0" OnChange="Run" />
    <Slider Label="@T("Chlorophyll-a µg/L", "Klorofil-a µg/L")" @bind-Value="_chl" Min="10" Max="300" Step="5" Format="0" OnChange="Run" />
    <Slider Label="@T("Aerators kW", "Kincir kW")" @bind-Value="_kw" Min="0" Max="10" Step="0.2" OnChange="Run" />
    <Slider Label="@T("DO set-point", "Set-point DO")" @bind-Value="_sp" Min="3" Max="6" Step="0.1" OnChange="Run" />
    <Slider Label="@T("Cloudiness", "Mendung")" @bind-Value="_wet" Min="0" Max="2" Step="0.1" OnChange="Run" />
</div>

<div class="grid kpis">
    <KpiCard Label="@T("Dawn DO, no aeration", "DO subuh tanpa aerasi")" Value="@F(_r.Off.MinDo)" Unit="mg/L" Note="@_r.Off.MinTime.ToString("HH:mm")" Tone="@(_r.Off.MinDo < DemoFarm.Species.DoCritical ? "alert" : "warn")" />
    <KpiCard Label="@T("Dawn DO, set-point", "DO subuh, set-point")" Value="@F(_r.On.MinDo)" Unit="mg/L" Tone="@(_r.On.MinDo >= DemoFarm.Species.DoCritical ? "good" : "alert")" />
    <KpiCard Label="@T("Aerator energy", "Energi kincir")" Value="@F(_r.On.AeratorKwh, "0")" Unit="kWh" Note="@Rp(_r.CostRp)" />
    <KpiCard Label="P(DO < 3)" Value="@F(_r.Forecast.ProbabilityBelowCritical * 100, "0")" Unit="%" Note="@_r.Forecast.Method" Tone="@(_r.Forecast.ProbabilityBelowCritical > 0.5 ? "alert" : "good")" />
    <KpiCard Label="@T("Start aerators by", "Nyalakan kincir paling lambat")" Value="@(_r.Forecast.AeratorStartBy?.ToString("HH:mm") ?? "—")" />
</div>

<div class="grid wide-left" style="margin-top:14px">
    <div class="panel"><h2>@T("36-hour oxygen budget", "Neraca oksigen 36 jam") <small>K-01 · 2 000 m² × 1.3 m</small></h2><SvgMarkup Svg="@_r.ChartSvg" /></div>
    <div class="panel"><h2>@T("Night fluxes", "Fluks malam")</h2><SvgMarkup Svg="@_r.BudgetSvg" />
        <div class="decision @(_r.Forecast.ProbabilityBelowCritical > 0.5 ? "Critical" : "Warning")"><span>@_r.Forecast.Advice[Lang]</span></div></div>
</div>

@code {
    private double _bio = 3000, _chl = 120, _kw = 4.4, _sp = 4.5, _wet = 1.0;
    private OxygenDemoResult _r = null!;
    protected override void OnInitialized() => Run();
    private void Run() => _r = OxygenDemo.Run(_bio, _chl, _kw, _sp, _wet);
}
