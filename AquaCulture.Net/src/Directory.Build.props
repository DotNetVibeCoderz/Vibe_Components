<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>aquaculture;fisheries;smart-farming;water-quality;shrimp;fish;iot;digital-twin;dotnet</PackageTags>
    <Description>AquaCulture.Net — The Ultimate Open Source Aquaculture Platform for .NET. Made by Gravicode Studios, led by Kang Fadhil.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(AquaRoot)assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(AquaRoot)PACKAGE.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
