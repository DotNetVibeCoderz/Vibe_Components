@* Renders trusted SVG generated by AquaCulture.Visualization. *@
<div class="aq-svg @Class" role="img" aria-label="@Label">@((MarkupString)Svg)</div>

@code {
    [Parameter, EditorRequired] public string Svg { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Label { get; set; }
}
