@* 3D digital pond rendered with Three.js: water colour follows DO, paddle wheels spin when aerators run, stock density follows biomass. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="aq-twin3d" style="height:@(Height)px">
    <canvas @ref="_canvas" aria-label="@(Lang == "id" ? "Kolam digital 3D" : "3D digital pond")"></canvas>
    @if (_error is not null)
    {
        <div class="aq-twin3d-error">@(Lang == "id" ? "Tampilan 3D membutuhkan WebGL" : "The 3D view needs WebGL") · @_error</div>
    }
    @if (State is { } s)
    {
        <div class="aq-twin3d-hud">
            <span><b>DO</b> @((s.Water.DissolvedOxygen ?? double.NaN).ToString("0.0", CultureInfo.InvariantCulture)) mg/L</span>
            <span><b>T</b> @((s.Water.TemperatureC ?? double.NaN).ToString("0.0", CultureInfo.InvariantCulture)) °C</span>
            <span><b>WQI</b> @s.Wqi.ToString("0", CultureInfo.InvariantCulture)</span>
            <span><b>@(Lang == "id" ? "Biomassa" : "Biomass")</b> @s.BiomassKg.ToString("N0", CultureInfo.InvariantCulture) kg</span>
            <span class="@(Aerator ? "on" : "off")">@(Aerator ? (Lang == "id" ? "Aerator ON" : "Aerators ON") : (Lang == "id" ? "Aerator OFF" : "Aerators OFF"))</span>
        </div>
    }
</div>

@code {
    [Parameter] public TwinState? State { get; set; }
    [Parameter] public double PondWidthM { get; set; } = 40;
    [Parameter] public double PondLengthM { get; set; } = 50;
    [Parameter] public double DepthM { get; set; } = 1.3;
    [Parameter] public int Aerators { get; set; } = 2;
    [Parameter] public int SensorCount { get; set; } = 3;
    [Parameter] public bool Shrimp { get; set; } = true;
    [Parameter] public bool Aerator { get; set; } = true;
    /// <summary>Standing biomass as a share of carrying capacity (0–1) — controls how many animals are drawn.</summary>
    [Parameter] public double BiomassRatio { get; set; } = 0.4;
    [Parameter] public int Height { get; set; } = 420;
    [Parameter] public string Lang { get; set; } = "en";

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private int _id = -1;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AquaCulture.Blazor/aquaTwin.js");
                _id = await _module.InvokeAsync<int>("create", _canvas, new { width = PondWidthM, length = PondLengthM, depth = DepthM, wheels = Aerators, sensors = SensorCount, animals = Shrimp ? "shrimp" : "fish" });
            }
            catch (JSException e)
            {
                _error = e.Message.Split(Environment.NewLine)[0];
                StateHasChanged();
                return;
            }
        }
        if (_module is not null && _id >= 0)
            await _module.InvokeVoidAsync("update", _id, new { @do = State?.Water.DissolvedOxygen ?? 6, aerator = Aerator, biomassRatio = Math.Clamp(BiomassRatio, 0.02, 1), alert = State?.ActiveAlerts.Count > 0 });
    }

    /// <summary>PNG data URI of the current frame.</summary>
    public async Task<string?> SnapshotAsync() => _module is null ? null : await _module.InvokeAsync<string?>("snapshot", _id);

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("dispose", _id); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
