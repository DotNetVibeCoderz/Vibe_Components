<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>GpdBlazorApp</title>
    <style>
        body { margin: 0; font-family: "Segoe UI", sans-serif; background: #edf1ea; color: #1b2a33; }
