<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GeoPandas.Net.CAD</RootNamespace>
    <Description>GeoPandas.Net CAD integration: AutoCAD DWG reader/writer (R14–2018, via ACadSharp), DXF (ASCII) reader and writer (POINT, LINE, LWPOLYLINE, POLYLINE, CIRCLE, ARC, ELLIPSE, SPLINE, TEXT, MTEXT, INSERT, 3DFACE) with layers and colours, MicroStation DGN v7 reader/writer, CAD ⇄ GIS georeferencing.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GeoPandas.Net.Data\GeoPandas.Net.Data.csproj" />
    <PackageReference Include="ACadSharp" />
  </ItemGroup>
</Project>
