<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GeoPandas.Net.Geometry</RootNamespace>
    <Description>GeoPandas.Net geometry engine: geometry factory (NetTopologySuite backend), CRS/projection engine (full EPSG dataset, 20 projection methods, PROJ4, WKT1/WKT2, ESRI PRJ, PROJJSON, NTv2 grid shifts, geoid models), spatial indexes (STRtree, QuadTree, KDTree, Octree, GeoHash), geodesy and SIMD/Rust native kernels.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NetTopologySuite" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GeoPandas.Net.Tests" />
  </ItemGroup>
  <!-- Native Rust kernels (optional; a managed SIMD fallback is always available).
       CI places per-RID builds in runtimes/<rid>/native/; locally the win-x64 cargo output is used. -->
  <ItemGroup>
    <None Include="runtimes\**\*" Pack="true" PackagePath="runtimes\" Visible="false" />
    <None Include="runtimes\win-x64\native\geopandas_native.dll" Condition="Exists('runtimes\win-x64\native\geopandas_native.dll') And '$(OS)' == 'Windows_NT'"
          CopyToOutputDirectory="PreserveNewest" Link="geopandas_native.dll" Pack="false" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)runtimes\win-x64\native\geopandas_native.dll') And Exists('$(MSBuildThisFileDirectory)..\..\native\geopandas_native\target\release\geopandas_native.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\native\geopandas_native\target\release\geopandas_native.dll"
          Pack="true" PackagePath="runtimes\win-x64\native\" CopyToOutputDirectory="PreserveNewest" Link="geopandas_native.dll" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Crs\Data\epsg.tsv.gz" LogicalName="GeoPandas.Net.Geometry.epsg.tsv.gz" />
    <EmbeddedResource Include="Crs\Data\egm96-1deg-int16.gz" LogicalName="GeoPandas.Net.Geometry.egm96-1deg-int16.gz" WithCulture="false" />
  </ItemGroup>
</Project>
