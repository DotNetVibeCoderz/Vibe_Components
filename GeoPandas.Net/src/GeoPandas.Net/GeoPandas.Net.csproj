    <ProjectReference Include="..\GeoPandas.Net.Arrow\GeoPandas.Net.Arrow.csproj" />
    <ProjectReference Include="..\GeoPandas.Net.PointCloud\GeoPandas.Net.PointCloud.csproj" />
