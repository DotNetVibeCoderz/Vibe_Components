    <ProjectReference Include="..\GeoPandas.Net.Analytics\GeoPandas.Net.Analytics.csproj" />
    <ProjectReference Include="..\GeoPandas.Net.Network\GeoPandas.Net.Network.csproj" />
    <ProjectReference Include="..\GeoPandas.Net.Raster\GeoPandas.Net.Raster.csproj" />
    <ProjectReference Include="..\GeoPandas.Net.CAD\GeoPandas.Net.CAD.csproj" />
    <ProjectReference Include="..\GeoPandas.Net.AI\GeoPandas.Net.AI.csproj" />
    <ProjectReference Include="..\GeoPandas.Net.Datasets\GeoPandas.Net.Datasets.csproj" />
  </ItemGroup>
</Project>
