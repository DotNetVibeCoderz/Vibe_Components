<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GeoPandas.Net</RootNamespace>
    <AssemblyName>GeoPandas.Net</AssemblyName>
    <Description>GeoPandas.Net — next-generation geospatial analytics for .NET 10. Meta-package bundling Core (GeoDataFrame), Geometry (CRS, spatial index), Data (GeoJSON, Shapefile, GeoPackage, CSV), Analytics, Network, Raster, CAD, AI and Datasets, plus the `Gpd` facade. Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil.</Description>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
