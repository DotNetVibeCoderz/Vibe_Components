<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Package metadata -->
    <VersionPrefix>0.3.0</VersionPrefix>
    <Authors>Gravicode Studios (Kang Fadhil)</Authors>
    <Company>Gravicode Studios</Company>
    <Product>GeoPandas.Net</Product>
    <Copyright>© 2026 Gravicode Studios. Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil.</Copyright>
    <PackageProjectUrl>https://github.com/DotNetVibeCoderz/Vibe_Components/tree/main/GeoPandas.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DotNetVibeCoderz/Vibe_Components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>gis;geospatial;geopandas;dataframe;crs;spatial-index;raster;geotiff;shapefile;geojson;geopackage;flatgeobuf;geoparquet;arrow;netcdf;lidar;las;laz;postgis;duckdb;network-analysis;dxf;cad;bim;digital-twin</PackageTags>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('\src\')) Or $(MSBuildProjectDirectory.Contains('/src/'))">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
