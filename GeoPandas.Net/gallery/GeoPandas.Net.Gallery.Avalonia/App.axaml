<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GeoPandas.Net.Gallery.Desktop.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button.toc">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6ECE4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="30,7,12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.toc:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#24394A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.toc.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2433" />
            <Setter Property="BorderBrush" Value="#B0306A" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
        </Style>
        <Style Selector="ToggleButton.pill">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1B2A33" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="ToggleButton.pill:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#1B2A33" />
            <Setter Property="Foreground" Value="#EDF1EA" />
        </Style>
        <Style Selector="ToggleButton.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#4A5A63" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
        <Style Selector="ToggleButton.tab:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#F7F9F5" />
            <Setter Property="Foreground" Value="#1B2A33" />
        </Style>
    </Application.Styles>
</Application>
