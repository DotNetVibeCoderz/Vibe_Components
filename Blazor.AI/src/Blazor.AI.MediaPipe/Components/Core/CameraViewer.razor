@namespace Blazor.AI.MediaPipe
@using System.Diagnostics
@using System.Text.Json
@using MediaPipeNet.Imaging
@implements IAsyncDisposable
@inject IJSRuntime JS
@* Universal camera: webcam/mobile camera, sample or uploaded images, video files and HTTP streams, with overlays, snapshots and recording. *@

<div class="baiv @Class">
    @if (ShowToolbar)
    {
        <div class="baiv-bar" role="toolbar" aria-label="Video source">
            @if (Samples.Count > 0)
            {
                <select class="bai-select" style="width:auto; max-width:12rem" aria-label="Sample picture" value="@_sampleUrl" @onchange="e => UseSampleAsync(e.Value?.ToString())">
                    @foreach (var s in Samples) { <option value="@s.Url">@s.Name</option> }
                </select>
            }
            @if (AllowCamera)
            {
                <button type="button" class="bai-chip @(_source == VisionSourceKind.Camera ? "is-active" : null)" @onclick="ToggleCameraAsync">
                    <i class="bi @(_source == VisionSourceKind.Camera ? "bi-camera-video-off" : "bi-camera-video")" aria-hidden="true"></i>@(_source == VisionSourceKind.Camera ? "Stop camera" : "Camera")
                </button>
                @if (_cameras.Count > 1)
                {
                    <select class="bai-select" style="width:auto; max-width:10rem" aria-label="Camera" @onchange="e => SwitchCameraAsync(e.Value?.ToString())">
                        @foreach (var c in _cameras) { <option value="@c.Id">@c.Label</option> }
                    </select>
                }
            }
            <label class="bai-chip" style="position:relative; cursor:pointer"><i class="bi bi-upload" aria-hidden="true"></i>Upload
                <InputFile OnChange="UploadAsync" accept="image/*,video/*" style="position:absolute; inset:0; opacity:0; cursor:pointer" aria-label="Upload an image or video" />
            </label>
            @if (AllowStreamUrl)
            {
                <button type="button" class="bai-chip @(_showUrl ? "is-active" : null)" @onclick="() => _showUrl = !_showUrl"><i class="bi bi-broadcast" aria-hidden="true"></i>URL</button>
            }
            <span class="bai-spacer"></span>
            <span class="baiv-stats" aria-live="off">
                <span>@Stats.Fps.ToString("0.0", CultureInfo.InvariantCulture) fps</span>
                <span>@Stats.LatencyMs.ToString("0", CultureInfo.InvariantCulture) ms</span>
                @if (Stats.Width > 0) { <span>@Stats.Width×@Stats.Height</span> }
            </span>
            <button type="button" class="bai-icon-btn" title="Mirror" aria-label="Mirror the picture" aria-pressed="@_mirror" @onclick="ToggleMirrorAsync"><i class="bi bi-symmetry-vertical" aria-hidden="true"></i></button>
            <button type="button" class="bai-icon-btn" title="Snapshot" aria-label="Take a snapshot" @onclick="SnapshotToUiAsync"><i class="bi bi-camera" aria-hidden="true"></i></button>
        </div>
        @if (_showUrl)
        {
            <form class="bai-row" @onsubmit="UseUrlAsync" @onsubmit:preventDefault="true">
                <input class="bai-input bai-spacer" @bind="_url" placeholder="https://…/stream.mjpg, .mp4, .m3u8 or an image URL (needs CORS)" aria-label="Stream URL" />
                <button type="submit" class="bai-btn-ghost">Open</button>
            </form>
        }
    }
    <div style="position:relative">
        <div @ref="_host" style="height:@Height"></div>
        @if (_message is not null)
        {
            <div class="baiv-empty" role="status"><i class="bi bi-camera-video-off" aria-hidden="true"></i>@_message</div>
        }
        @if (ChildContent is not null)
        {
            <div class="bai3d-hud" style="z-index:2">@ChildContent</div>
        }
    </div>
    @if (_snapshot is not null)
    {
        <div class="bai-row">
            <img src="@_snapshot" alt="Snapshot" style="max-height:90px; border-radius:8px; border:1px solid var(--bai-line)" />
            <button type="button" class="bai-btn-ghost" @onclick="DownloadSnapshotAsync"><i class="bi bi-download" aria-hidden="true"></i>Save</button>
            <button type="button" class="bai-btn-ghost" @onclick="() => _snapshot = null">Close</button>
        </div>
    }
</div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CameraViewer>? _self;
    private int _id;
    private VisionSourceKind _source = VisionSourceKind.Image;
    private string? _sampleUrl, _url, _message, _snapshot, _deviceId;
    private bool _mirror, _showUrl;
    private List<CameraInfo> _cameras = [];
    private readonly Stopwatch _clock = Stopwatch.StartNew();
    private double _fps, _latency;
    private long _frames;
    private TimeSpan _lastFrameAt;

    private sealed record CameraInfo(string Id, string Label);

    /// <summary>Called for every frame; return what to draw (or null). Runs on the circuit; offload heavy work.</summary>
    [Parameter] public Func<VisionFrame, Task<VisionOverlay?>>? OnFrame { get; set; }

    /// <summary>Raised when the source changes (reset tracking state here).</summary>
    [Parameter] public EventCallback<VisionSourceKind> OnSourceChanged { get; set; }

    [Parameter] public IReadOnlyList<VisionSample> Samples { get; set; } = VisionSamples.People;

    /// <summary>The first sample to show; defaults to the first of <see cref="Samples"/>.</summary>
    [Parameter] public string? InitialImage { get; set; }

    /// <summary>Start the webcam immediately instead of a sample (needs a user gesture in some browsers).</summary>
    [Parameter] public bool StartWithCamera { get; set; }

    [Parameter] public bool AllowCamera { get; set; } = true;
    [Parameter] public bool AllowStreamUrl { get; set; } = true;
    [Parameter] public bool ShowToolbar { get; set; } = true;
    [Parameter] public string FacingMode { get; set; } = "user";

    /// <summary>Frames per second requested from live sources (the actual rate is limited by processing time).</summary>
    [Parameter] public double Fps { get; set; } = 12;

    /// <summary>Frames are downscaled to this width before upload (smaller is faster).</summary>
    [Parameter] public int MaxWidth { get; set; } = 640;

    [Parameter] public string Height { get; set; } = "420px";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public VisionStats Stats { get; private set; } = new(0, 0, 0, 0, 0);

    public VisionSourceKind Source => _source;

    /// <summary>The last frame received (JPEG), for snapshots or vision-language models.</summary>
    public byte[]? LastJpeg { get; private set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Blazor.AI.MediaPipe/blazor-ai-vision.js");
            _self = DotNetObjectReference.Create(this);
            _id = await _module.InvokeAsync<int>("create", _host, _self);
            if (StartWithCamera && AllowCamera)
            {
                await StartAsync(VisionSourceKind.Camera, null);
            }
            else
            {
                await UseSampleAsync(InitialImage ?? Samples.FirstOrDefault()?.Url);
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>Switches to a source. Returns null on success or a message to show.</summary>
    public async Task<string?> StartAsync(VisionSourceKind source, string? url)
    {
        if (_module is null)
        {
            return "Not ready yet.";
        }

        _message = null;
        _source = source;
        _frames = 0;
        await OnSourceChanged.InvokeAsync(source);
        var options = new CameraStartOptions
        {
            Source = source, Url = url, DeviceId = _deviceId, FacingMode = FacingMode, Fps = Fps, MaxWidth = MaxWidth,
            Mirror = _mirror || (source == VisionSourceKind.Camera && FacingMode == "user"),
        };
        if (source == VisionSourceKind.Camera)
        {
            _mirror = options.Mirror;
        }

        var result = await _module.InvokeAsync<string>("start", _id, JsonSerializer.Serialize(options, VisionJsonContext.Default.CameraStartOptions));
        if (result != "ok")
        {
            _message = result;
            if (source == VisionSourceKind.Camera)
            {
                _source = VisionSourceKind.Image;
            }
        }
        else if (source == VisionSourceKind.Camera && _cameras.Count == 0)
        {
            _cameras = (await _module.InvokeAsync<CameraInfo[]>("listCameras")).ToList();
        }

        StateHasChanged();
        return _message;
    }

    public Task UseSampleAsync(string? url)
    {
        _sampleUrl = url;
        return url is null ? Task.CompletedTask : StartAsync(VisionSourceKind.Image, url);
    }

    private Task ToggleCameraAsync() => _source == VisionSourceKind.Camera ? UseSampleAsync(_sampleUrl ?? Samples.FirstOrDefault()?.Url) : StartAsync(VisionSourceKind.Camera, null);

    private Task SwitchCameraAsync(string? deviceId)
    {
        _deviceId = deviceId;
        return StartAsync(VisionSourceKind.Camera, null);
    }

    private Task UseUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_url))
        {
            return Task.CompletedTask;
        }

        var kind = System.Text.RegularExpressions.Regex.IsMatch(_url, @"\.(png|jpe?g|webp|gif|bmp)(\?|$)", System.Text.RegularExpressions.RegexOptions.IgnoreCase) ? VisionSourceKind.Image
            : System.Text.RegularExpressions.Regex.IsMatch(_url, @"\.(mp4|webm|mov|m3u8)(\?|$)", System.Text.RegularExpressions.RegexOptions.IgnoreCase) ? VisionSourceKind.Video
            : VisionSourceKind.Stream;
        return StartAsync(kind, _url.Trim());
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var isVideo = file.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);
        var max = isVideo ? 300L * 1024 * 1024 : 25L * 1024 * 1024;
        if (file.Size > max)
        {
            _message = $"That file is too large ({file.Size / 1024 / 1024} MB). The limit is {max / 1024 / 1024} MB.";
            return;
        }

        await using var stream = file.OpenReadStream(max);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var url = await _module!.InvokeAsync<string>("objectUrl", ms.ToArray(), file.ContentType);
        await StartAsync(isVideo ? VisionSourceKind.Video : VisionSourceKind.Image, url);
    }

    private async Task ToggleMirrorAsync()
    {
        _mirror = !_mirror;
        if (_source != VisionSourceKind.Image || _sampleUrl is not null)
        {
            await StartAsync(_source, _source == VisionSourceKind.Image ? _sampleUrl : _url);
        }
    }

    /// <summary>Processes the current still image again (after a setting changed).</summary>
    public async Task ReprocessAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("reprocess", _id);
        }
    }

    /// <summary>JPEG data URL of the picture with its overlay.</summary>
    public async Task<string?> SnapshotAsync(bool withOverlay = true) =>
        _module is null ? null : await _module.InvokeAsync<string?>("snapshot", _id, withOverlay);

    private async Task SnapshotToUiAsync() => _snapshot = await SnapshotAsync();

    private async Task DownloadSnapshotAsync()
    {
        if (_snapshot is not null && _module is not null)
        {
            await _module.InvokeVoidAsync("download", _snapshot, $"snapshot-{DateTime.Now:yyyyMMdd-HHmmss}.jpg");
        }
    }

    public async Task<bool> StartRecordingAsync(int fps = 24) => _module is not null && await _module.InvokeAsync<bool>("startRecording", _id, fps);

    /// <summary>Stops recording; returns an object URL of the WebM clip.</summary>
    public async Task<string?> StopRecordingAsync() => _module is null ? null : await _module.InvokeAsync<string?>("stopRecording", _id);

    public async Task DownloadAsync(string url, string fileName)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("download", url, fileName);
        }
    }

    /// <summary>Draws an overlay directly (for replays), bypassing <see cref="OnFrame"/>.</summary>
    public async Task SetOverlayAsync(VisionOverlay? overlay)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setOverlay", _id, overlay is null ? null : JsonSerializer.Serialize(overlay, VisionJsonContext.Default.VisionOverlay));
        }
    }

    public async Task StopAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("stop", _id);
        }
    }

    [JSInvokable("OnFrame")]
    public async Task<string?> ReceiveFrameAsync(byte[] jpeg, int width, int height, long timestampMs, bool live, long index)
    {
        if (OnFrame is null)
        {
            return null;
        }

        var started = _clock.Elapsed;
        using var activity = VisionTelemetry.Source.StartActivity("vision.frame");
        LastJpeg = jpeg;
        VisionOverlay? overlay;
        using (var image = MPImage.Load(jpeg))
        {
            var frame = new VisionFrame { Image = image, TimestampMs = timestampMs, IsLive = live, Jpeg = jpeg, Index = index };
            try
            {
                overlay = await OnFrame(frame);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                overlay = new VisionOverlay { Status = "Processing failed: " + ex.Message };
                VisionTelemetry.Errors.Add(1);
            }
        }

        var elapsed = (_clock.Elapsed - started).TotalMilliseconds;
        var gap = (started - _lastFrameAt).TotalSeconds;
        _lastFrameAt = started;
        _latency = _frames == 0 ? elapsed : _latency * 0.8 + elapsed * 0.2;
        _fps = gap > 0 && _frames > 0 ? _fps * 0.8 + (1 / gap) * 0.2 : 0;
        _frames++;
        Stats = new VisionStats(live ? _fps : 0, _latency, _frames, width, height);
        VisionTelemetry.Frames.Add(1);
        VisionTelemetry.Latency.Record(elapsed);
        if (!live || _frames % 6 == 0)
        {
            _ = InvokeAsync(StateHasChanged);
        }

        return overlay is null ? null : JsonSerializer.Serialize(overlay, VisionJsonContext.Default.VisionOverlay);
    }

    [JSInvokable]
    public Task OnSourceError(string message)
    {
        _message = message;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSourceEnded() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _id);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (TaskCanceledException)
            {
            }
        }

        _self?.Dispose();
    }
}
