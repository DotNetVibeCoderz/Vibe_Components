@namespace Blazor.AI.MediaPipe
@inherits VisionComponentBase
@* 478-point face mesh with contours, head pose, eye openness and the strongest blendshapes. *@

<div class="@CssClass("baiv-split")">
    <CameraViewer @ref="Camera" OnFrame="HandleFrameAsync" OnSourceChanged="HandleSourceChanged" Samples="@EffectiveSamples" StartWithCamera="@StartWithCamera" Fps="@Fps" Height="@Height" />
    <AiCard Title="@Title" Subtitle="@($"{_faces} face(s) · 478 landmarks · 52 blendshapes")" Icon="bi-person-bounding-box">
        <div class="bai-stack">
            <div class="bai-row bai-small">
                <label><input type="checkbox" class="form-check-input" @bind="_allPoints" @bind:after="Refresh" /> all points</label>
                <label><input type="checkbox" class="form-check-input" @bind="_contours" @bind:after="Refresh" /> contours</label>
                <label>Faces <input type="number" min="1" max="4" class="bai-input" style="width:4rem" @bind="_numFaces" @bind:after="Refresh" /></label>
            </div>
            @if (_face is { } f)
            {
                <div class="bai3d-kpi" style="display:flex; gap:1rem">
                    <div><b>@f.Yaw.ToString("+0;-0", CultureInfo.InvariantCulture)°</b><span class="bai-small bai-muted"> yaw</span></div>
                    <div><b>@f.Pitch.ToString("+0;-0", CultureInfo.InvariantCulture)°</b><span class="bai-small bai-muted"> pitch</span></div>
                    <div><b>@(f.EyesOpen ? "open" : "closed")</b><span class="bai-small bai-muted"> eyes</span></div>
                </div>
                <span class="bai-label">Strongest blendshapes</span>
                @foreach (var (name, score) in f.Top)
                {
                    <div class="baiv-meter"><span>@name</span><div><span style="width:@((score * 100).ToString("0", CultureInfo.InvariantCulture))%"></span></div><span class="bai-num">@score.ToString("0.00", CultureInfo.InvariantCulture)</span></div>
                }
            }
            else
            {
                <p class="bai-small bai-muted" style="margin:0">No face found. Face the camera with even light.</p>
            }
        </div>
    </AiCard>
</div>

@code {
    private bool _allPoints = true, _contours = true;
    private int _numFaces = 1, _faces;
    private FaceSummary? _face;

    private sealed record FaceSummary(double Yaw, double Pitch, bool EyesOpen, IReadOnlyList<(string Name, float Score)> Top);

    [Parameter] public string Title { get; set; } = "Face landmarks";

    /// <summary>Raised with each frame's result (on the processing thread).</summary>
    [Parameter] public Action<FaceLandmarkResult>? OnResult { get; set; }

    protected override VisionOverlay? Process(VisionFrame frame)
    {
        var result = Tasks.FaceLandmarks(frame, Math.Clamp(_numFaces, 1, 4));
        OnResult?.Invoke(result);
        _faces = result.Faces.Count;
        var overlay = new VisionOverlay();
        foreach (var face in result.Faces)
        {
            foreach (var layer in Overlay.Face(face, _allPoints))
            {
                if (layer.Connections is null || _contours)
                {
                    overlay.Landmarks.Add(layer);
                }
            }
        }

        if (result.Faces.FirstOrDefault() is { } first)
        {
            var aspect = frame.Width / (double)frame.Height;
            var (yaw, pitch) = VisionMath.HeadPose(first.Landmarks);
            var (l, r) = VisionMath.EyeAspectRatio(first.Landmarks, aspect);
            var top = (first.Blendshapes ?? []).Where(b => b.CategoryName != "_neutral").OrderByDescending(b => b.Score).Take(6).Select(b => (b.CategoryName ?? "?", b.Score)).ToList();
            _face = new FaceSummary(yaw, pitch, (l + r) / 2 > 0.18, top);
        }
        else
        {
            _face = null;
        }

        overlay.Status = _faces == 0 ? "No face" : $"{_faces} face{(_faces > 1 ? "s" : "")}";
        return overlay;
    }

    private Task Refresh() => Camera?.ReprocessAsync() ?? Task.CompletedTask;
}
