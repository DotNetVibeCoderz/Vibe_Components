<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>Blazor.AI.MediaPipe</PackageId>
    <Title>Blazor.AI.MediaPipe</Title>
    <Description>Real-time computer-vision components for Blazor on MediaPipe.NET (native .NET MediaPipe Tasks on ONNX Runtime): camera viewer and overlays, face detection, 478-point face mesh and blendshapes, attendance and verification, hand tracking and gestures, sign language, pose and exercise analytics, holistic tracking and motion capture, background removal, object detection, image classification, vision copilot, 3D avatars and industry, health, agritech and analytics dashboards.</Description>
    <PackageTags>$(PackageTags);mediapipe;computer-vision;face-tracking;hand-tracking;pose-estimation;gesture;segmentation;object-detection;webcam</PackageTags>
  </PropertyGroup>

  <!-- Inference runs on the server (ONNX Runtime); components use Interactive Server render mode. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Gravicode.MediaPipeNet.Tasks.Vision" />
    <!-- Native ONNX Runtime (CPU; DirectML/CUDA packages can replace it). MediaPipeNet only references the managed API. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blazor.AI.Components\Blazor.AI.Components.csproj" />
    <ProjectReference Include="..\Blazor.AI.Visualization\Blazor.AI.Visualization.csproj" />
    <ProjectReference Include="..\Blazor.AI.ThreeD\Blazor.AI.ThreeD.csproj" />
  </ItemGroup>

  <!-- MediaPipeNet depends on SixLabors.ImageSharp 3.1.12; see docs/en/security.md. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>

</Project>
