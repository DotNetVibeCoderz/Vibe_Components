{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "BlazorAI": {
//#if (useOpenAI)
    "DefaultProvider": "openai",
//#elseif (useAzure)
    "DefaultProvider": "azure",
//#elseif (useAnthropic)
    "DefaultProvider": "anthropic",
//#elseif (useOllama)
    "DefaultProvider": "ollama",
//#else
    "DefaultProvider": "simulated",
//#endif
    "Providers": [
      { "Name": "simulated", "Kind": "Simulated", "DisplayName": "Simulated (offline)" }
//#if (useOpenAI)
      , { "Name": "openai", "Kind": "OpenAI", "Model": "gpt-5-mini", "ApiKey": "" }
//#elseif (useAzure)
      , { "Name": "azure", "Kind": "AzureOpenAI", "Endpoint": "https://<resource>.openai.azure.com/", "Model": "<deployment>", "ApiKey": "" }
//#elseif (useAnthropic)
      , { "Name": "anthropic", "Kind": "Anthropic", "Model": "claude-sonnet-5-5", "ApiKey": "" }
//#elseif (useOllama)
      , { "Name": "ollama", "Kind": "Ollama", "Endpoint": "http://localhost:11434", "Model": "llama3.2" }
//#endif
    ],
    "Guardrails": { "Audit": true, "RedactPii": false, "ModerateContent": true }
  }
}
