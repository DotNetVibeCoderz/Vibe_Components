<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Blazor.AI.Templates</PackageId>
    <Title>Blazor.AI project templates</Title>
    <Description>dotnet new templates for Blazor.AI: a Blazor Web App wired with AI providers, chat, SmartPaste and the kawung theme. Install with: dotnet new install Blazor.AI.Templates, then: dotnet new blazorai -n MyApp.</Description>
    <PackageType>Template</PackageType>
    <PackageTags>$(PackageTags);dotnet-new;templates</PackageTags>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
    <Compile Remove="content\**\*" />
    <None Remove="content\**\*" />
  </ItemGroup>

</Project>
