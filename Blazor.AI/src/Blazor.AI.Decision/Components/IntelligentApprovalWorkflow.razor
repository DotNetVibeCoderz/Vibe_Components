@namespace Blazor.AI.Decision
@inherits AiComponentBase
@*
    Three-stage approvals: (1) deterministic rules auto-approve or auto-reject clear cases, (2) TypeSafe judges the
    rest with a confidence, (3) low-confidence or "review" cases go to a human. Every step is logged for audit.
*@

<AiCard Title="@Title" Subtitle="Rules → AI judgement → human, with an audit trail" Icon="bi-check2-circle" Class="@Class">
    <div class="bai-grid-2" style="align-items:start">
        <div class="bai-stack">
            <div class="bai-grid-2">
                <div><label class="bai-label" for="iaw-who">Requester</label><input id="iaw-who" class="bai-input" @bind="_request.Requester" /></div>
                <div><label class="bai-label" for="iaw-amt">Amount (Rp)</label><input id="iaw-amt" type="number" class="bai-input" @bind="_request.Amount" /></div>
            </div>
            <div><label class="bai-label" for="iaw-cat">Category</label>
                <select id="iaw-cat" class="bai-select" @bind="_request.Category">
                    @foreach (var c in new[] { "software", "hardware", "travel", "training", "marketing", "consulting" }) { <option>@c</option> }
                </select>
            </div>
            <div><label class="bai-label" for="iaw-just">Justification</label><textarea id="iaw-just" class="bai-textarea" rows="4" @bind="_request.Justification"></textarea></div>
            <div class="bai-grid-2">
                <div><label class="bai-label" for="iaw-auto">Auto-approve up to (Rp)</label><input id="iaw-auto" type="number" class="bai-input" @bind="AutoApproveLimit" /></div>
                <div><label class="bai-label" for="iaw-conf">Human review below confidence</label><input id="iaw-conf" type="number" step="0.05" min="0" max="1" class="bai-input" @bind="ConfidenceThreshold" /></div>
            </div>
            <button type="button" class="bai-btn bai-btn-ai" disabled="@IsBusy" @onclick="SubmitAsync"><i class="bi bi-send" aria-hidden="true"></i>Submit request</button>
            <AiError Message="@Error" />
        </div>
        <div class="bai-stack">
            @if (_log.Count == 0)
            {
                <div class="bai-empty"><i class="bi bi-inbox" aria-hidden="true"></i>Submit a request to see it move through the stages.</div>
            }
            else
            {
                <ol style="list-style:none; margin:0; padding:0; border-left:2px solid var(--bai-line-strong)">
                    @foreach (var entry in _log)
                    {
                        <li style="position:relative; padding:0 0 .9rem 1.1rem">
                            <span style="position:absolute; left:-.45rem; top:.15rem; width:.8rem; height:.8rem; border-radius:50%; background:@entry.Color"></span>
                            <div class="bai-row bai-small"><strong>@entry.Stage</strong><span class="bai-spacer"></span><span class="bai-num bai-faint">@entry.At.ToString("HH:mm:ss")</span></div>
                            <div class="bai-small">@entry.Message</div>
                        </li>
                    }
                </ol>
                @if (_awaitingHuman)
                {
                    <div class="bai-output">
                        <span class="bai-label">Your decision as approver</span>
                        <textarea class="bai-textarea" rows="2" @bind="_note" placeholder="Note for the audit trail (optional)"></textarea>
                        <div class="bai-row" style="margin-top:.5rem">
                            <button type="button" class="bai-btn" style="background:var(--bai-nila)" @onclick="() => Human(true)"><i class="bi bi-check2" aria-hidden="true"></i>Approve</button>
                            <button type="button" class="bai-btn" style="background:var(--bai-danger)" @onclick="() => Human(false)"><i class="bi bi-x-lg" aria-hidden="true"></i>Reject</button>
                        </div>
                    </div>
                }
                @if (_final is not null)
                {
                    <div class="bai-alert @(_final == "Approved" ? "is-info" : null)" role="status"><i class="bi @(_final == "Approved" ? "bi-check-circle" : "bi-x-circle")" aria-hidden="true"></i><strong>@_final</strong></div>
                }
            }
        </div>
    </div>
</AiCard>

@code {
    private readonly Request _request = new();
    private readonly List<LogEntry> _log = [];
    private bool _awaitingHuman;
    private string? _final, _note;

    [Inject] private TypeSafeDecisionService TypeSafe { get; set; } = default!;
    [Inject] private Blazor.AI.Abstractions.Security.IAuditTrail Audit { get; set; } = default!;

    [Parameter] public string Title { get; set; } = "Intelligent approval workflow";
    [Parameter] public double AutoApproveLimit { get; set; } = 2_000_000;
    [Parameter] public double AutoRejectAbove { get; set; } = 500_000_000;
    [Parameter] public double ConfidenceThreshold { get; set; } = 0.75;
    [Parameter] public EventCallback<string> OnDecided { get; set; }

    private Task SubmitAsync() => RunAsync(async ct =>
    {
        _log.Clear();
        _final = null;
        _awaitingHuman = false;
        Log("Submitted", $"{_request.Requester} requests Rp {_request.Amount:N0} for {_request.Category}.", "var(--bai-ink-faint)");

        // Stage 1: deterministic rules.
        if (_request.Amount <= AutoApproveLimit)
        {
            Log("Rules", $"Amount ≤ Rp {AutoApproveLimit:N0}: auto-approved.", "var(--bai-nila)");
            await FinishAsync("Approved");
            return;
        }

        if (_request.Amount > AutoRejectAbove)
        {
            Log("Rules", $"Amount above Rp {AutoRejectAbove:N0}: outside delegated authority, rejected.", "var(--bai-danger)");
            await FinishAsync("Rejected");
            return;
        }

        Log("Rules", "No rule decides this case; sending to AI judgement.", "var(--bai-ink-faint)");
        StateHasChanged();

        // Stage 2: TypeSafe judgement.
        var decision = await TypeSafe.ChooseAsync(_request, ["approve", "review", "reject"],
            "Decide on this purchase request. Approve clear business needs with reasonable cost, reject unjustified spending, choose review when information is missing.", ct);
        Log(TypeSafe.IsSimulated ? "AI (simulated)" : "AI · TypeSafe", $"Suggests \"{decision.Choice}\" with {decision.Confidence:P0} confidence.", "var(--bai-soga)");

        if (decision.Choice != "review" && decision.Confidence >= ConfidenceThreshold)
        {
            await FinishAsync(decision.Choice == "approve" ? "Approved" : "Rejected");
            return;
        }

        // Stage 3: human.
        Log("Human review", decision.Choice == "review" ? "AI asked for a human decision." : $"Confidence below {ConfidenceThreshold:P0}; waiting for an approver.", "var(--bai-tarum)");
        _awaitingHuman = true;
    });

    private async Task Human(bool approve)
    {
        _awaitingHuman = false;
        Log("Approver", (approve ? "Approved" : "Rejected") + (string.IsNullOrWhiteSpace(_note) ? "." : $": {_note}"), approve ? "var(--bai-nila)" : "var(--bai-danger)");
        await FinishAsync(approve ? "Approved" : "Rejected");
    }

    private async Task FinishAsync(string outcome)
    {
        _final = outcome;
        Audit.Record(new Blazor.AI.Abstractions.Security.AuditEntry(DateTimeOffset.UtcNow, Blazor.AI.Abstractions.Security.AuditKind.Info, "approval-workflow", _request.Requester,
            $"{outcome}: Rp {_request.Amount:N0} {_request.Category}", AiTasks.Decision));
        await OnDecided.InvokeAsync(outcome);
    }

    private void Log(string stage, string message, string color) => _log.Add(new LogEntry(stage, message, color, DateTimeOffset.Now));

    private sealed record LogEntry(string Stage, string Message, string Color, DateTimeOffset At);

    private sealed class Request
    {
        public string Requester { get; set; } = "Dimas (Engineering)";
        public double Amount { get; set; } = 18_500_000;
        public string Category { get; set; } = "software";
        public string Justification { get; set; } = "Annual license for the CI/CD platform used by 25 engineers; replaces two tools we pay Rp 22 million for today.";
    }
}
