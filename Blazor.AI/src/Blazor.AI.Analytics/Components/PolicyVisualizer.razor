@namespace Blazor.AI.Analytics
@implements IDisposable
@* What did the agent learn? For Q-table agents on grid worlds: the best action per cell (arrows) over a state-value heatmap. *@

<AiCard Title="@Title" Subtitle="@(Session?.Name ?? "Train a Q-learning agent on the designed grid first")" Icon="bi-signpost" Class="@Class">
    <Actions>
        <select class="bai-select" style="width:auto" value="@_index" @onchange="Pick" aria-label="Training session">
            @for (var i = 0; i < Candidates.Count; i++) { <option value="@i">@Candidates[i].Name (#@(i + 1))</option> }
        </select>
    </Actions>
    <ChildContent>
        @if (Session is { Agent: RLNet.Agents.QTableAgent agent, EnvironmentInstance: DesignedGridWorld grid })
        {
            var values = new double[grid.Height, grid.Width];
            var actions = new int[grid.Height, grid.Width];
            for (var y = 0; y < grid.Height; y++)
            {
                for (var x = 0; x < grid.Width; x++)
                {
                    var q = agent.ValuesForObservation(grid.ObservationOf(x, y)).ToArray();
                    values[y, x] = q.Length == 0 ? 0 : q.Max();
                    actions[y, x] = q.Length == 0 ? -1 : Array.IndexOf(q, q.Max());
                }
            }

            var min = values.Cast<double>().Min();
            var max = values.Cast<double>().Max();
            const double cell = 52;
            <svg viewBox="0 0 @(grid.Width * cell) @(grid.Height * cell)" style="width:100%; max-width:@(grid.Width * cell + 40)px; display:block; margin:0 auto" role="img" aria-label="Learned policy">
                @for (var y = 0; y < grid.Height; y++)
                {
                    @for (var x = 0; x < grid.Width; x++)
                    {
                        var tile = grid.At(x, y);
                        var fill = tile switch { GridTile.Wall => "var(--bai-ink-muted)", GridTile.Goal => "var(--bai-nila)", GridTile.Trap => "var(--bai-danger)", _ => ColormapColor("viridis", values[y, x], min, max) };
                        <rect x="@(x * cell + 1)" y="@(y * cell + 1)" width="@(cell - 2)" height="@(cell - 2)" rx="5" fill="@fill"><title>V = @values[y, x].ToString("0.000", CultureInfo.InvariantCulture)</title></rect>
                        @if (tile is GridTile.Empty or GridTile.Start && actions[y, x] >= 0)
                        {
                            <!text x="@(x * cell + cell / 2)" y="@(y * cell + cell / 2 + 8)" text-anchor="middle" style="font-size:22px; pointer-events:none" fill="@ReadableOn(ColormapColor("viridis", values[y, x], min, max))">@Arrows[actions[y, x]]</!text>
                        }
                    }
                }
            </svg>
            <p class="bai-small bai-muted" style="margin:.5rem 0 0">Colour = value of the best action from that cell (brighter is better). Arrows show the greedy policy. @agent.StateCount states visited.</p>
        }
        else if (Session is not null)
        {
            <div class="bai-empty"><i class="bi bi-signpost" aria-hidden="true"></i>Policy maps need a Q-learning agent on the designed grid. For neural agents, use the simulation runner.</div>
        }
        else
        {
            <div class="bai-empty"><i class="bi bi-signpost" aria-hidden="true"></i>No trained sessions yet.</div>
        }
    </ChildContent>
</AiCard>

@code {
    private static readonly string[] Arrows = ["↑", "→", "↓", "←"];
    private int _index = -1;

    [Inject] private RlWorkspace Workspace { get; set; } = default!;

    [Parameter] public string Title { get; set; } = "Policy visualizer";
    [Parameter] public string? Class { get; set; }

    private IReadOnlyList<TrainingSession> Candidates => Workspace.Sessions;

    private TrainingSession? Session => Candidates.Count == 0 ? null : Candidates[_index < 0 || _index >= Candidates.Count ? LatestGrid() : _index];

    private int LatestGrid()
    {
        for (var i = Candidates.Count - 1; i >= 0; i--)
        {
            if (Candidates[i].Agent is RLNet.Agents.QTableAgent && Candidates[i].EnvironmentInstance is DesignedGridWorld)
            {
                return i;
            }
        }

        return Candidates.Count - 1;
    }

    protected override void OnInitialized() => Workspace.Changed += Refresh;

    private void Pick(ChangeEventArgs e) => _index = int.Parse(e.Value!.ToString()!, CultureInfo.InvariantCulture);

    private void Refresh() => InvokeAsync(() =>
    {
        _index = -1;
        StateHasChanged();
    });

    public void Dispose() => Workspace.Changed -= Refresh;
}
