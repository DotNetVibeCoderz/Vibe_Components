@namespace Blazor.AI.Agents
@implements IDisposable
@* A team of agents on one task: pipeline, round-table discussion, or supervisor-routed. *@

<AiCard Title="@Title" Subtitle="Several specialists, one result" Icon="bi-people" Class="@Class">
    <div class="bai-stack">
        <div>
            <span class="bai-label">Team</span>
            <div class="bai-chips">
                @foreach (var agent in Catalog.Agents)
                {
                    var on = _team.Contains(agent.Id);
                    <button type="button" class="bai-chip @(on ? "is-active" : null)" aria-pressed="@on" @onclick="() => Toggle(agent.Id)">
                        <i class="bi @agent.Icon" aria-hidden="true"></i>@agent.Name
                    </button>
                }
            </div>
        </div>
        <div class="bai-grid-2">
            <div>
                <label class="bai-label" for="mam-mode">How they work together</label>
                <select id="mam-mode" class="bai-select" @bind="_mode">
                    <option value="@OrchestrationMode.Sequential">Pipeline: each builds on the previous</option>
                    <option value="@OrchestrationMode.RoundRobin">Round table: take turns discussing</option>
                    <option value="@OrchestrationMode.Supervisor">Supervisor: a manager routes the work</option>
                </select>
            </div>
            <div>
                <label class="bai-label" for="mam-rounds">Rounds</label>
                <input id="mam-rounds" type="number" min="1" max="5" class="bai-input" @bind="_rounds" disabled="@(_mode == OrchestrationMode.Sequential)" />
            </div>
        </div>
        <div class="bai-row">
            <input class="bai-input bai-spacer" @bind="_task" placeholder="Task, e.g. Write a business case for solar panels on a 2,000 m² factory roof" aria-label="Task" />
            @if (_cts is null)
            {
                <button type="button" class="bai-btn bai-btn-ai" disabled="@(string.IsNullOrWhiteSpace(_task) || _team.Count == 0)" @onclick="RunAsync"><i class="bi bi-play-fill" aria-hidden="true"></i>Run team</button>
            }
            else
            {
                <button type="button" class="bai-btn" @onclick="() => _cts?.Cancel()"><i class="bi bi-stop-fill" aria-hidden="true"></i>Stop</button>
            }
        </div>
        <AiError Message="@_error" />

        @foreach (var message in _messages)
        {
            <article class="bai-msg is-assistant">
                <span class="bai-msg-avatar" aria-hidden="true"><i class="bi @message.Icon"></i></span>
                <div class="bai-msg-body">
                    <div class="bai-msg-meta">
                        <strong>@message.Agent</strong>
                        @if (message.Note is not null) { <span>@message.Note</span> }
                        @if (message.Run is { ToolCalls: > 0 } run) { <span class="bai-tool-call" style="margin:0"><i class="bi bi-tools" aria-hidden="true"></i>@run.ToolCalls tool calls</span> }
                    </div>
                    <div class="bai-output">
                        @if (string.IsNullOrEmpty(message.Text)) { <AiThinking /> } else { <AiMarkdown Text="@message.Text" /> }
                    </div>
                </div>
            </article>
        }
    </div>
</AiCard>

@code {
    private readonly List<string> _team = [];
    private readonly List<AgentMessage> _messages = [];
    private OrchestrationMode _mode = OrchestrationMode.Sequential;
    private int _rounds = 1;
    private string? _task, _error;
    private CancellationTokenSource? _cts;
    private long _lastRender;

    [Inject] private AgentCatalog Catalog { get; set; } = default!;
    [Inject] private MultiAgentOrchestrator Orchestrator { get; set; } = default!;

    [Parameter] public string Title { get; set; } = "Multi-agent panel";
    [Parameter] public string? Task { get; set; }
    [Parameter] public string? Provider { get; set; }
    [Parameter] public string? Class { get; set; }

    protected override void OnInitialized()
    {
        _task = Task;
        _team.AddRange(new[] { "researcher", "writer", "reviewer" }.Where(id => Catalog.Get(id) is not null));
    }

    private void Toggle(string id)
    {
        if (!_team.Remove(id))
        {
            _team.Add(id);
        }
    }

    private async Task RunAsync()
    {
        _messages.Clear();
        _error = null;
        _cts = new CancellationTokenSource();
        var agents = _team.Select(id => Catalog.Get(id)).Where(a => a is not null).Cast<AgentDefinition>().ToList();
        try
        {
            await foreach (var message in Orchestrator.RunAsync(_task!, agents, _mode, _rounds, Provider, onUpdate: Throttle, cancellationToken: _cts.Token))
            {
                if (!_messages.Contains(message))
                {
                    _messages.Add(message);
                }

                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _error = AiComponentBase.Describe(ex);
        }
        finally
        {
            _cts = null;
        }
    }

    // The orchestrator streams into messages that are not yielded yet; show them as soon as they have text.
    private void Throttle(AgentMessage message)
    {
        if (!_messages.Contains(message))
        {
            _messages.Add(message);
        }

        var now = Environment.TickCount64;
        if (now - _lastRender > 60)
        {
            _lastRender = now;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => _cts?.Cancel();
}
