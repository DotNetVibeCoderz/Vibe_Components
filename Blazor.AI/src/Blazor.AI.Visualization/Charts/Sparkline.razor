@namespace Blazor.AI.Visualization

<svg viewBox="0 0 @Width @Height" width="@Width" height="@Height" aria-hidden="true" class="bai-sparkline">
    @if (Values.Count > 1)
    {
        var min = Values.Min();
        var max = Values.Max();
        var range = max - min < 1e-12 ? 1 : max - min;
        var points = Values.Select((v, i) => (i * (Width - 2.0) / (Values.Count - 1) + 1, Height - 2 - (v - min) / range * (Height - 4))).ToArray();
        <path d="@($"{Path(points)}L{S(points[^1].Item1)},{Height} L1,{Height} Z")" fill="@Color" fill-opacity="0.12" />
        <path d="@Path(points)" fill="none" stroke="@Color" stroke-width="1.6" stroke-linejoin="round" />
    }
</svg>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<double> Values { get; set; } = [];
    [Parameter] public int Width { get; set; } = 96;
    [Parameter] public int Height { get; set; } = 28;
    [Parameter] public string Color { get; set; } = "var(--bai-soga)";
}
