<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AspNetVersion>10.0.12</AspNetVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- AI abstractions -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.10.0" />
    <PackageVersion Include="Anthropic" Version="12.50.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.1.0" />
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.12" />
    <PackageVersion Include="Gravicode.OfficeNet.PdfNet" Version="1.3.0" />
    <!-- Patched transitive dependency of PdfNet (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Gravicode ecosystem -->
    <PackageVersion Include="Gravicode.Science.GraviNum" Version="1.4.0" />
    <PackageVersion Include="Gravicode.Science.GraviFrame" Version="1.4.0" />
    <PackageVersion Include="Gravicode.Science.GraviLearn" Version="1.4.0" />
    <PackageVersion Include="Gravicode.Science.GraviProb" Version="1.4.0" />
    <PackageVersion Include="Gravicode.Visual.Net.Core" Version="1.2.0" />
    <PackageVersion Include="Gravicode.TypeSafeSdk" Version="1.1.0" />
    <PackageVersion Include="Gravicode.RLNet" Version="0.1.0" />
    <PackageVersion Include="Gravicode.HFNet.GraviHub" Version="0.11.1" />
    <PackageVersion Include="Gravicode.HFNet.GraviTransformers" Version="0.11.1" />
    <PackageVersion Include="Gravicode.HFNet.GraviTransformers.Vision" Version="0.11.1" />
    <PackageVersion Include="Gravicode.MediaPipeNet.Tasks.Vision" Version="1.0.0" />
    <!-- ImageSharp 3.x (no license key; 4.x requires one for Release builds). Known advisories are suppressed in
         Blazor.AI.LocalModels.csproj and mitigated with upload size limits; see docs/en/security.md. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <!-- Biotech.Net (Gravicode) for Blazor.AI.Bio -->
    <PackageVersion Include="Gravicode.Biotech.Net.Sequences" Version="0.2.0" />
    <PackageVersion Include="Gravicode.Biotech.Net.Alignments" Version="0.2.0" />
    <PackageVersion Include="Gravicode.Biotech.Net.Proteomics" Version="0.2.0" />
    <PackageVersion Include="Gravicode.Biotech.Net.Chemistry" Version="0.2.0" />
    <PackageVersion Include="Gravicode.Biotech.Net.DrugDiscovery" Version="0.2.0" />
    <PackageVersion Include="Gravicode.Biotech.Net.SyntheticBiology" Version="0.2.0" />
    <PackageVersion Include="Gravicode.Biotech.Net.Transcriptomics" Version="0.2.0" />
    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(AspNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(AspNetVersion)" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="bunit" Version="1.40.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
