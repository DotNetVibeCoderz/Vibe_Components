<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CesiumNet.Gallery.Avalonia.ViewModels"
        x:Class="CesiumNet.Gallery.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cesium.Net Gallery"
        Icon="/Assets/app.ico"
        Width="1480" Height="940" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

  <Grid ColumnDefinitions="300,*">

    <!-- ===================== Rail: brand, search, sample index, settings ===================== -->
    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" Padding="18,16,18,14" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
          <Border.Background>
            <VisualBrush TileMode="Tile" DestinationRect="0,0,22,22" SourceRect="0,0,22,22" Stretch="None">
              <VisualBrush.Visual>
                <Canvas Width="22" Height="22" Background="{StaticResource Panel}">
                  <Rectangle Width="22" Height="1" Fill="#DCE1DA" />
                  <Rectangle Width="1" Height="22" Fill="#DCE1DA" />
                </Canvas>
              </VisualBrush.Visual>
            </VisualBrush>
          </Border.Background>
          <Button Command="{Binding GoHomeCommand}" Background="{StaticResource Panel}" Padding="4,4,12,4" HorizontalAlignment="Left"
                  ToolTip.Tip="Home">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Image Source="/Assets/logo-128.png" Width="34" Height="34" />
              <TextBlock FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="21" VerticalAlignment="Center">
                <Run Text="Cesium" /><Run Text=".Net" Foreground="{StaticResource Datum}" />
              </TextBlock>
              <Border BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" Padding="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Classes="eyebrow" Text="GALLERY" FontSize="10.5" Foreground="{StaticResource Ink3}" />
              </Border>
            </StackPanel>
          </Button>
        </Border>

        <TextBox Grid.Row="1" Margin="18,14,18,6" PlaceholderText="{Binding L[Search]}" Text="{Binding Query}" />

        <ListBox Grid.Row="2" Classes="index" Margin="10,4,10,10"
                 ItemsSource="{Binding Index}" SelectedItem="{Binding SelectedItem}">
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:IndexHeader">
              <TextBlock Classes="index-cat" Text="{Binding Title}" Margin="0,10,0,0" />
            </DataTemplate>
            <DataTemplate DataType="vm:IndexSample">
              <DockPanel>
                <TextBlock Classes="entry-coord" DockPanel.Dock="Right" Text="{Binding Coord}" Margin="10,0,0,0" />
                <TextBlock Classes="entry-title" Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>

        <Border Grid.Row="3" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="18,14,18,16">
          <StackPanel Spacing="10">
            <Border BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <ToggleButton Classes="lang" Content="EN" IsChecked="{Binding IsEnglish}" />
                <ToggleButton Classes="lang" Content="ID" IsChecked="{Binding IsIndonesian}" />
              </StackPanel>
            </Border>
            <Expander Header="{Binding L[Settings]}" HorizontalAlignment="Stretch" Padding="0,8,0,0">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding L[IonToken]}" FontSize="12" />
                <TextBox PasswordChar="•" Text="{Binding TokenDraft}" PlaceholderText="eyJhbGciOi…" />
                <TextBlock Text="{Binding L[IonHint]}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Ink2}" />
                <Button Classes="primary" Content="{Binding L[Save]}" Command="{Binding SaveTokenCommand}" />
              </StackPanel>
            </Expander>
            <TextBlock Text="{Binding L[Credit]}" FontSize="12" Foreground="{StaticResource Ink3}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ===================== Stage ===================== -->
    <Panel Grid.Column="1">

      <!-- Home: copy beside a live, spinning globe (native WebViews cannot be overlaid). -->
      <Grid IsVisible="{Binding IsHome}" RowDefinitions="*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="480,*" Background="{StaticResource Night}">
          <Border Grid.Column="0" Padding="44,32" BorderBrush="#23303B" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Center" Spacing="16">
              <TextBlock Classes="eyebrow" Foreground="#9AA8B2">
                <Run Text="GRAVICODE STUDIOS   " /><Run Text="{Binding CesiumVersion}" Foreground="{StaticResource Survey}" />
              </TextBlock>
              <TextBlock FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="68" Foreground="#E8EDF1" LineHeight="66">
                <Run Text="Cesium" /><Run Text=".Net" Foreground="#6F92FF" />
              </TextBlock>
              <TextBlock Classes="lede" Text="{Binding L[Tagline]}" Foreground="#C3CDD5" />
              <StackPanel Spacing="6" Margin="0,6,0,6">
                <Border Background="#05080C" BorderBrush="#23303B" BorderThickness="1" CornerRadius="4" Padding="12,8">
                  <TextBlock Classes="mono" Foreground="{StaticResource Survey}"><Run Text="$ " Foreground="#6F7D88" /><Run Text="dotnet add package Cesium.Net.Avalonia" /></TextBlock>
                </Border>
                <Border Background="#05080C" BorderBrush="#23303B" BorderThickness="1" CornerRadius="4" Padding="12,8">
                  <TextBlock Classes="mono" Foreground="{StaticResource Survey}"><Run Text="$ " Foreground="#6F7D88" /><Run Text="dotnet add package Cesium.Net.Blazor" /></TextBlock>
                </Border>
              </StackPanel>
              <Button Classes="primary" Content="{Binding StartText}" Command="{Binding StartFirstCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <ContentControl Grid.Column="1" x:Name="HomeViewerHost" />
        </Grid>

        <Border Grid.Row="1" Padding="28,22,28,26">
          <StackPanel Spacing="14">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Classes="mono" Foreground="{StaticResource Ink2}" Text="{Binding SampleCountText}" VerticalAlignment="Bottom" />
              <TextBlock Classes="h1" FontSize="28" Text="{Binding FieldGuideText}" />
            </DockPanel>
            <Border Height="1" Background="{StaticResource Rule}" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Topics}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:TopicCard">
                    <Border Width="236" Background="{StaticResource Panel}" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="6" Padding="16,14">
                      <StackPanel Spacing="4">
                        <TextBlock FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="17" Text="{Binding Title}" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Text="{Binding Blurb}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Samples}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:IndexSample">
                              <Button Content="{Binding Title}" Background="Transparent" Padding="0,2" Foreground="{StaticResource DatumInk}"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenSampleCommand}" CommandParameter="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Sample workbench -->
      <Grid IsVisible="{Binding !IsHome}" RowDefinitions="Auto,*" Margin="28,22,28,24">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,18" DataContext="{Binding Current}" x:DataType="vm:SampleViewModel">
          <TextBlock Classes="eyebrow">
            <Run Text="{Binding Eyebrow}" /><Run Text="   " /><Run Text="{Binding Coord}" Foreground="{StaticResource Ink3}" />
          </TextBlock>
          <TextBlock Classes="h1" Text="{Binding Title}" />
          <TextBlock Classes="lede" Text="{Binding Summary}" MaxWidth="980" HorizontalAlignment="Left" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,18,380">
          <!-- viewer card with the reticle readout -->
          <Border Grid.Column="0" Background="{StaticResource Night}" CornerRadius="6" ClipToBounds="True">
            <Grid RowDefinitions="*,Auto">
              <ContentControl Grid.Row="0" x:Name="ViewerHost" />
              <Border Grid.Row="1" Background="{StaticResource Night}" BorderBrush="#1E2933" BorderThickness="0,1,0,0" Padding="14,9"
                      DataContext="{Binding Current}" x:DataType="vm:SampleViewModel">
                <DockPanel>
                  <Canvas DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Rectangle Canvas.Left="6" Width="2" Height="14" Fill="{StaticResource Survey}" />
                    <Rectangle Canvas.Top="6" Width="14" Height="2" Fill="{StaticResource Survey}" />
                  </Canvas>
                  <Border DockPanel.Dock="Right" BorderBrush="#2A3946" BorderThickness="1" CornerRadius="3" Padding="6,2">
                    <TextBlock Classes="ret-k" Margin="0" Text="WGS84" />
                  </Border>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <TextBlock Classes="ret-k" Text="LAT" /><TextBlock Classes="ret-v" Text="{Binding Lat}" />
                    <TextBlock Classes="ret-k" Text="LON" /><TextBlock Classes="ret-v" Text="{Binding Lon}" />
                    <TextBlock Classes="ret-k" Text="ALT" /><TextBlock Classes="ret-v" Text="{Binding Alt}" />
                    <TextBlock Classes="ret-k" Text="HDG" /><TextBlock Classes="ret-v" Text="{Binding Heading}" />
                    <TextBlock Classes="ret-k" Text="PITCH" /><TextBlock Classes="ret-v" Text="{Binding Pitch}" />
                    <TextBlock Classes="ret-k" Text="CURSOR" /><TextBlock Classes="ret-v" Foreground="#E8EDF1" Text="{Binding Cursor}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </Grid>
          </Border>

          <!-- side panel -->
          <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="6"
                  DataContext="{Binding Current}" x:DataType="vm:SampleViewModel">
            <TabControl Classes="panel-tabs" Padding="0">
              <TabItem Header="{Binding L[Overview]}">
                <ScrollViewer Padding="18,8,18,18">
                  <StackPanel Spacing="4">
                    <Border IsVisible="{Binding UsesIon}" BorderBrush="{StaticResource Survey}" BorderThickness="3,0,0,0" Background="{StaticResource Paper}" Padding="12,10" Margin="0,0,0,14">
                      <TextBlock Text="{Binding IonNote}" TextWrapping="Wrap" FontSize="13" />
                    </Border>
                    <TextBlock Classes="panel-h" Text="TRY IT" IsVisible="{Binding HasActions}" />
                    <ItemsControl ItemsSource="{Binding Actions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ActionViewModel">
                          <Button Classes="action" Content="{Binding Label}" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="panel-h" Text="LATEST EVENT" Margin="0,22,0,10" />
                    <SelectableTextBlock Classes="mono" Text="{Binding LastEvent}" TextWrapping="Wrap" Foreground="{StaticResource Ink2}" />
                    <Button Classes="ghost" Margin="0,22,0,0" Content="{Binding L[Restart]}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestartCommand}" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="{Binding L[Code]}">
                <DockPanel>
                  <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="12,6">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Classes="ghost" Padding="10,4" FontSize="12" x:Name="CopyButton" Content="{Binding L[Copy]}" Click="OnCopyCode" />
                      <TextBlock Classes="mono" Foreground="{StaticResource Ink2}" VerticalAlignment="Center" Text="{Binding FileName}" />
                    </DockPanel>
                  </Border>
                  <ScrollViewer Background="{StaticResource Night}" HorizontalScrollBarVisibility="Auto">
                    <SelectableTextBlock x:Name="CodeBlock" Margin="16,14" FontFamily="{StaticResource MonoFont}" FontSize="12.5" LineHeight="20" Foreground="#D7DEE4" />
                  </ScrollViewer>
                </DockPanel>
              </TabItem>
              <TabItem Header="{Binding L[Events]}">
                <ScrollViewer Padding="18,10" x:Name="LogScroll">
                  <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:LogEntry">
                        <Border BorderBrush="#DCE1DA" BorderThickness="0,0,0,1" Padding="0,6">
                          <Grid ColumnDefinitions="68,*">
                            <TextBlock Classes="mono" Foreground="{StaticResource Ink3}" Text="{Binding Time}" />
                            <SelectableTextBlock Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding Message}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Border>
        </Grid>
      </Grid>
    </Panel>
  </Grid>
</Window>
