<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CesiumNet.Gallery.Avalonia.App"
             RequestedThemeVariant="Light">
  <!-- Cesium.Net Gallery — "survey station" theme (mirrors the Blazor gallery tokens). -->
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="PaperColor">#E9ECE6</Color>
      <Color x:Key="PanelColor">#F7F8F4</Color>
      <Color x:Key="InkColor">#15212A</Color>
      <Color x:Key="Ink2Color">#4E5B63</Color>
      <Color x:Key="Ink3Color">#7A868C</Color>
      <Color x:Key="RuleColor">#C9D0C7</Color>
      <Color x:Key="DatumColor">#1F4FE0</Color>
      <Color x:Key="DatumInkColor">#1739A8</Color>
      <Color x:Key="DatumWashColor">#E4EAFC</Color>
      <Color x:Key="SurveyColor">#F5C518</Color>
      <Color x:Key="NightColor">#0B1016</Color>

      <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}" />
      <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
      <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
      <SolidColorBrush x:Key="Ink2" Color="{StaticResource Ink2Color}" />
      <SolidColorBrush x:Key="Ink3" Color="{StaticResource Ink3Color}" />
      <SolidColorBrush x:Key="Rule" Color="{StaticResource RuleColor}" />
      <SolidColorBrush x:Key="Datum" Color="{StaticResource DatumColor}" />
      <SolidColorBrush x:Key="DatumInk" Color="{StaticResource DatumInkColor}" />
      <SolidColorBrush x:Key="DatumWash" Color="{StaticResource DatumWashColor}" />
      <SolidColorBrush x:Key="Survey" Color="{StaticResource SurveyColor}" />
      <SolidColorBrush x:Key="Night" Color="{StaticResource NightColor}" />
      <SolidColorBrush x:Key="NightText" Color="#C9D3DC" />
      <SolidColorBrush x:Key="NightMuted" Color="#6F7D88" />

      <FontFamily x:Key="DisplayFont">avares://Cesium.Net.Gallery.Avalonia/Assets/Fonts#Chakra Petch</FontFamily>
      <FontFamily x:Key="BodyFont">avares://Cesium.Net.Gallery.Avalonia/Assets/Fonts#IBM Plex Sans</FontFamily>
      <FontFamily x:Key="MonoFont">avares://Cesium.Net.Gallery.Avalonia/Assets/Fonts#IBM Plex Mono</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="Background" Value="{StaticResource Paper}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <!-- type -->
    <Style Selector="TextBlock.eyebrow, SelectableTextBlock.eyebrow">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="LetterSpacing" Value="1.4" />
      <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="32" />
    </Style>
    <Style Selector="TextBlock.lede">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{StaticResource Ink2}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style Selector="TextBlock.panel-h">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="1.4" />
      <Setter Property="Foreground" Value="{StaticResource Ink3}" />
      <Setter Property="Margin" Value="0,4,0,10" />
    </Style>
    <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- buttons -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DatumWash}" />
      <Setter Property="BorderBrush" Value="{StaticResource Datum}" />
      <Setter Property="Foreground" Value="{StaticResource DatumInk}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Datum}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DatumInk}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    </Style>
    <Style Selector="ToggleButton.lang">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.lang:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Ink}" />
      <Setter Property="Foreground" Value="{StaticResource Panel}" />
    </Style>

    <!-- sample index -->
    <Style Selector="ListBox.index">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.index ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBox.index ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DatumWash}" />
    </Style>
    <Style Selector="ListBox.index ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="ListBox.index ListBoxItem:selected TextBlock.entry-title">
      <Setter Property="Foreground" Value="{StaticResource Panel}" />
    </Style>
    <Style Selector="ListBox.index ListBoxItem:selected TextBlock.entry-coord">
      <Setter Property="Foreground" Value="{StaticResource Survey}" />
    </Style>
    <Style Selector="TextBlock.entry-coord">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource Ink3}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.index-cat">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="1.4" />
      <Setter Property="Foreground" Value="{StaticResource Ink3}" />
    </Style>

    <!-- reticle (signature) -->
    <Style Selector="TextBlock.ret-k">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource NightMuted}" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="TextBlock.ret-v">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Survey}" />
      <Setter Property="Margin" Value="0,0,18,0" />
    </Style>

    <!-- tabs -->
    <Style Selector="TabControl.panel-tabs TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="14,0" />
    </Style>
  </Application.Styles>
</Application>
