<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CesiumNet.Gallery</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cesium.Net\Cesium.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sample sources are embedded so the gallery can show the exact code that runs. -->
    <EmbeddedResource Include="Samples\**\*.cs" LogicalName="Samples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
