<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Gravicode Studios (Kang Fadhil)</Authors>
    <Company>Gravicode Studios</Company>
    <Product>Agritech.Net</Product>
    <Copyright>© 2026 Gravicode Studios. Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil.</Copyright>
    <IsPackable>false</IsPackable>
    <PackageProjectUrl>https://github.com/DotNetVibeCoderz/Vibe_Components/tree/main/Agritech.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DotNetVibeCoderz/Vibe_Components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <AgritechRoot>$(MSBuildThisFileDirectory)</AgritechRoot>
  </PropertyGroup>
</Project>
