<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Agritech.Templates</PackageId>
    <Title>Agritech.Net project templates</Title>
    <Description>dotnet new templates for Agritech.Net: console farm advisor, Blazor farm dashboard, IoT edge gateway (MQTT + digital twin) and Avalonia desktop field viewer. Made by Gravicode Studios, led by Kang Fadhil.</Description>
    <PackageTags>agritech;agriculture;dotnet-new;templates;blazor;avalonia;iot</PackageTags>
    <IsPackable>true</IsPackable>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content/**/*" Exclude="content/**/bin/**;content/**/obj/**" />
    <Compile Remove="**/*" />
    <None Include="$(AgritechRoot)assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(AgritechRoot)PACKAGE.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
