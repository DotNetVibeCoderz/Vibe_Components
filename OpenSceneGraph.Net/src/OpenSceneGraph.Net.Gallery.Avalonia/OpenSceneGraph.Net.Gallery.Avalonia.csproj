<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OpenSceneGraph.Net.Gallery</AssemblyName>
    <RootNamespace>OpenSceneGraph.Net.Gallery.Desktop</RootNamespace>
    <Description>OpenSceneGraph.Net Gallery (Avalonia desktop). Created by Gravicode Studios, led by Kang Fadhil.</Description>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenSceneGraph.Net.Avalonia\OpenSceneGraph.Net.Avalonia.csproj" />
    <ProjectReference Include="..\OpenSceneGraph.Net.Gallery.Core\OpenSceneGraph.Net.Gallery.Core.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\icon-64.png" Link="Assets\icon-64.png" />
    <AvaloniaResource Include="..\..\assets\icon.ico" Link="Assets\icon.ico" />
    <!-- rendered thumbnails (produced by screenshot mode) are shown on the sample cards when present -->
    <Content Include="..\..\docs\images\gallery\*.png" Link="thumbnails\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
