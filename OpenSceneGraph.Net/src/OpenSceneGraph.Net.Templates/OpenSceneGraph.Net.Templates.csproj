<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>OpenSceneGraph.Net.Templates</PackageId>
    <Title>OpenSceneGraph.Net project templates</Title>
    <Description>dotnet new templates for OpenSceneGraph.Net: console (native osgViewer / offscreen render), Avalonia desktop and Blazor WebAssembly 3D apps. Created by Gravicode Studios, led by Kang Fadhil.</Description>
    <PackageTags>$(PackageTags);dotnet-new;templates</PackageTags>
    <IsPackable>true</IsPackable>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
  </ItemGroup>
</Project>
