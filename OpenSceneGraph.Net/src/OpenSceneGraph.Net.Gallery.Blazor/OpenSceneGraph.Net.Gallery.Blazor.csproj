<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <Description>OpenSceneGraph.Net Gallery for the web (Blazor WebAssembly). Created by Gravicode Studios, led by Kang Fadhil.</Description>
    <RootNamespace>OpenSceneGraph.Net.Gallery.Web</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
  </PropertyGroup>
  <!-- Optional ahead-of-time compilation (much faster cull/update than the interpreter):
       dotnet workload install wasm-tools
       dotnet publish -c Release -p:OsgAot=true -->
  <PropertyGroup Condition="'$(OsgAot)' == 'true'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenSceneGraph.Net.Gallery.Core\OpenSceneGraph.Net.Gallery.Core.csproj" />
    <ProjectReference Include="..\OpenSceneGraph.Net.Blazor\OpenSceneGraph.Net.Blazor.csproj" />
  </ItemGroup>
</Project>
