<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:g="using:GDAL.Net.Avalonia">

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="Background" Value="{DynamicResource Paper}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <!-- ============================================================ type -->
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="1.3" />
    <Setter Property="Foreground" Value="{DynamicResource Ink3}" />
  </Style>
  <Style Selector="TextBlock.brand">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="LetterSpacing" Value="-1" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="27" />
    <Setter Property="LetterSpacing" Value="-0.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="17" />
  </Style>
  <Style Selector="TextBlock.lede">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="23" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.panel-h">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="1.4" />
    <Setter Property="Foreground" Value="{DynamicResource Ink3}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- ============================================================ surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource ShoalWash}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="7,2" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ShoalInk}" />
  </Style>
  <Style Selector="Border.swatch">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ============================================================ rail -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShoalWash}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
  </Style>

  <Style Selector="Button.rail-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="22,5,8,5" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
  </Style>
  <Style Selector="Button.rail-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShoalWash}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.rail-item.selected">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
  </Style>
  <Style Selector="Button.rail-item.selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
  </Style>

  <!-- ============================================================ cards on home -->
  <Style Selector="Button.sample-card">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,14,14" />
    <Setter Property="Width" Value="300" />
    <Setter Property="Height" Value="168" />
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.sample-card:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shoal}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <!-- ============================================================ actions -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shoal}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,5" />
  </Style>
  <Style Selector="ToggleButton.seg">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="11,4" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Ink2}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
  </Style>

  <!-- ============================================================ tabs -->
  <Style Selector="TabControl.panel-tabs">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.panel-tabs TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <!-- ============================================================ code -->
  <Style Selector="Border.code">
    <Setter Property="Background" Value="{DynamicResource CodeBg}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <Style Selector="SelectableTextBlock.code">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{DynamicResource CodeText}" />
  </Style>
  <Style Selector="Border.output">
    <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- ============================================================ controls -->
  <Style Selector="g|GdalMapView">
    <Setter Property="OverlayFontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="g|GdalHistogramChart">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="g|GdalColorLegend">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="g|GdalSrsExplorer">
    <Setter Property="MonoFontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="g|GdalDatasetInfoPanel TextBlock.gdal-section">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="DataGrid">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
</Styles>
