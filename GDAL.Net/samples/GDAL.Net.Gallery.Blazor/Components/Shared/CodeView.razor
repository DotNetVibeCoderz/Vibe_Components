@inject IJSRuntime JS
@inject UiState Ui

<div class="code">
    <div class="code__bar">
        <span class="code__lang">C#</span>
        <button type="button" class="code__copy" @onclick="CopyAsync">@(_copied ? Ui.T("Copied", "Tersalin") : Ui.T("Copy code", "Salin kode"))</button>
    </div>
    <pre tabindex="0"><code>@((MarkupString)CodeHighlighter.ToHtml(Code))</code></pre>
</div>

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = "";

    private bool _copied;

    private async Task CopyAsync()
    {
        _copied = await JS.InvokeAsync<bool>("gdalGallery.copy", Code);
        StateHasChanged();
        await Task.Delay(1600);
        _copied = false;
    }
}
