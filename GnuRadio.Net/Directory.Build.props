<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <TieredPGO>true</TieredPGO>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <!-- Attribution travels inside every assembly's metadata, not only in the README. -->
  <PropertyGroup>
    <Authors>Kang Fadhil (Gravicode Studios)</Authors>
    <Company>Gravicode Studios</Company>
    <Product>GnuRadio.Net</Product>
    <Description>Software Defined Radio and DSP framework for .NET, modelled on GNU Radio. Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil.</Description>
    <Copyright>Copyright (c) 2026 Gravicode Studios. Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil.</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <PackageProjectUrl>https://github.com/DotNetVibeCoderz/Vibe_Components/tree/main/GnuRadio.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DotNetVibeCoderz/Vibe_Components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>gnuradio;sdr;dsp;radio;rf;software-defined-radio;fft;modulation;ofdm;fec;ldpc;viterbi;blazor;avalonia</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <!-- EnableDefaultNoneItems is off, so the files the package metadata points at are listed by hand. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CreatedBy" Value="Gravicode Studios dipimpin oleh Kang Fadhil" />
  </ItemGroup>

</Project>
