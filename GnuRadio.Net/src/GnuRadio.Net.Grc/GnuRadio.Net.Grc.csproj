<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GnuRadio.Grc</RootNamespace>
    <PackageId>GnuRadio.Net.Grc</PackageId>
    <Description>Load GNU Radio Companion (.grc) flowgraphs into GnuRadio.Net, run them, and generate equivalent C# code. Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil.</Description>
    <PackageTags>$(PackageTags);grc;gnuradio-companion;codegen</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GnuRadio.Net.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GnuRadio.Net/GnuRadio.Net.csproj" />
  </ItemGroup>

</Project>
