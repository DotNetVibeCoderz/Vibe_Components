<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GnuRadio.ZeroMQ</RootNamespace>
    <PackageId>GnuRadio.Net.ZeroMQ</PackageId>
    <Description>ZeroMQ stream and message blocks for GnuRadio.Net, wire-compatible with GNU Radio's gr-zeromq (PUB/SUB, PUSH/PULL, REQ/REP). Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil.</Description>
    <PackageTags>$(PackageTags);zeromq;zmq;netmq;distributed</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetMQ" Version="4.0.1.16" />
    <!-- NetMQ's transitive 8.0.x crypto packages have published advisories; pin patched releases. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GnuRadio.Net/GnuRadio.Net.csproj" />
  </ItemGroup>

</Project>
