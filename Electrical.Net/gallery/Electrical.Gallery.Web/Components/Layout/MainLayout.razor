@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="shell">
    <header class="topbar">
        <button class="icon-btn menu-toggle" @onclick="() => _menuOpen = !_menuOpen" aria-expanded="@Aria.B(_menuOpen)" aria-controls="rail" aria-label="@T("Open navigation", "Buka navigasi")">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        </button>
        <a class="brand" href="@Href("")">
            <img src="favicon.svg" alt="" width="34" height="34" />
            <span class="brand-word">Electrical<span>.Net</span></span>
            <span class="brand-tag">@T("Gallery", "Galeri")</span>
        </a>
        <span class="stamp">@ElectricalInfo.Version · .NET 10 · @T("computed live on the server", "dihitung langsung di server")</span>
        <div class="top-actions">
            <div class="seg small" role="group" aria-label="Language / Bahasa">
                <button aria-pressed="@Aria.B(_lang == "en")" @onclick='() => SetLang("en")'>EN</button>
                <button aria-pressed="@Aria.B(_lang == "id")" @onclick='() => SetLang("id")'>ID</button>
            </div>
            <button class="icon-btn theme-toggle" @onclick="ToggleTheme" aria-label="@T("Switch light or dark theme", "Ganti tema terang atau gelap")" title="@T("Light / dark", "Terang / gelap")">
                <svg class="sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M10 1.8v2.4M10 15.8v2.4M1.8 10h2.4M15.8 10h2.4M4.2 4.2l1.7 1.7M14.1 14.1l1.7 1.7M4.2 15.8l1.7-1.7M14.1 5.9l1.7-1.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                <svg class="moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M15.5 12.6A6.5 6.5 0 0 1 7.4 4.5a6.5 6.5 0 1 0 8.1 8.1Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
            </button>
        </div>
    </header>

    <div class="frame">
        <nav id="rail" class="rail @(_menuOpen ? "open" : "")" aria-label="@T("Demos", "Demo")">
            <NavLink class="rail-link home" href="@Href("")" Match="NavLinkMatch.All" @onclick="CloseMenu">
                <span class="lamp on"></span>@T("Overview", "Ringkasan")
            </NavLink>
            @foreach (var c in GalleryCatalog.Categories)
            {
                <div class="rail-group">
                    <div class="rail-title">@c.Name[_lang]</div>
                    @foreach (var d in GalleryCatalog.Demos.Where(x => x.Category == c.Key))
                    {
                        <NavLink class="rail-link" href="@Href($"demo/{d.Id}")" @onclick="CloseMenu">
                            <span class="lamp"></span>@d.Title[_lang]
                        </NavLink>
                    }
                </div>
            }
            <a class="rail-link modules" href="@Href("#modules")" @onclick="CloseMenu"><span class="lamp dim"></span>@T("All 23 modules", "Semua 23 modul")</a>
        </nav>

        <main class="content">
            <CascadingValue Value="_lang" Name="Lang">
                @Body
            </CascadingValue>
            <footer class="credit">
                <div>
                    <img src="favicon.svg" alt="" width="22" height="22" />
                    <strong>Electrical.Net</strong> — @GalleryCatalog.Tagline[_lang]
                </div>
                <div>@GalleryCatalog.Credit[_lang]</div>
            </footer>
        </main>
    </div>
</div>

@code {
    private string _lang = "en";
    private bool _menuOpen;

    protected override void OnInitialized()
    {
        if (new Uri(Nav.Uri).Query.Contains("lang=id", StringComparison.Ordinal)) _lang = "id";
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (new Uri(Nav.Uri).Query.Contains("lang=", StringComparison.Ordinal)) { await JS.InvokeVoidAsync("elnTheme.setLang", _lang); return; }
        var saved = await JS.InvokeAsync<string?>("elnTheme.getLang");
        if (saved is "id" or "en" && saved != _lang) { _lang = saved; StateHasChanged(); }
    }

    private string T(string en, string id) => _lang == "id" ? id : en;

    /// <summary>Keeps ?lang=id on internal links so pages opened in a new tab keep the language.</summary>
    private string Href(string path) => _lang == "id" && !path.StartsWith('#') ? $"{path}{(path.Contains('?') ? "&" : "?")}lang=id" : path;

    private async Task SetLang(string lang)
    {
        _lang = lang;
        await JS.InvokeVoidAsync("elnTheme.setLang", lang);
    }

    private async Task ToggleTheme()
    {
        var current = await JS.InvokeAsync<string>("elnTheme.get");
        await JS.InvokeVoidAsync("elnTheme.set", current == "dark" ? "light" : "dark");
    }

    private void OnLocationChanged(object? s, LocationChangedEventArgs e)
    {
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void CloseMenu() => _menuOpen = false;
    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
