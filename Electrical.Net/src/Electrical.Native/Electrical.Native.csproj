<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Native (Rust) high-performance kernels for Electrical.Net — FFT/THD, batch complex vector operations, Monte-Carlo sampling — with automatic managed fallback.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Prebuilt native binaries produced by build/build-native.ps1 (cargo build, release profile). -->
    <None Include="runtimes/**/native/*" Pack="true" PackagePath="runtimes/" CopyToOutputDirectory="PreserveNewest" Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Electrical.Tests" />
  </ItemGroup>
</Project>
