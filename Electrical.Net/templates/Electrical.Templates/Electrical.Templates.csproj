<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Electrical.Templates</PackageId>
    <Title>Electrical.Net project templates</Title>
    <Description>dotnet new templates for Electrical.Net: power-system study console, unbalanced distribution feeder study, Blazor grid dashboard, Avalonia single-line viewer, SCADA edge gateway (Modbus TCP + alarms) and power-system REST API. Made by Gravicode Studios, led by Kang Fadhil.</Description>
    <PackageTags>electrical;power-system;smart-grid;dotnet-new;templates;blazor;avalonia;scada</PackageTags>
    <IsPackable>true</IsPackable>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content/**/*" Exclude="content/**/bin/**;content/**/obj/**" />
    <Compile Remove="**/*" />
    <None Include="$(ElectricalRoot)assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(ElectricalRoot)PACKAGE.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
